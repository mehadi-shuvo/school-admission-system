# Copy to .env before changing values for a shared environment. Do not commit .env.
POSTGRES_DB=school_admission
POSTGRES_USER=school_admission
POSTGRES_PASSWORD=replace-with-a-strong-local-password
BACKEND_PORT=8080
FRONTEND_PORT=3000
# Internal Docker hostname and port used by Nginx for same-origin /api requests.
FRONTEND_API_UPSTREAM=backend:8080
